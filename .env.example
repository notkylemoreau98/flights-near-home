# Copy to .env.local and fill in.

# Nominatim (OpenStreetMap geocoder) requires an identifying User-Agent.
NOMINATIM_USER_AGENT="flights-near-home/1.0 (your-email@example.com)"

# Default home location shown before you set an address in the UI.
NEXT_PUBLIC_HOME_ADDRESS="Los Angeles, CA"
NEXT_PUBLIC_HOME_LAT=34.0537
NEXT_PUBLIC_HOME_LON=-118.2428

# Radius around home, in miles.
NEXT_PUBLIC_RADIUS_MI=15
